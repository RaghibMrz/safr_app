{
  "name": "safr_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:ios:development:local": "dotenv -e .env.development -- eas build --local -p ios --profile development",
    "build:ios:development": "dotenv -e .env.development -- eas build -p ios --profile development",
    "build:ios:preview:local": "dotenv -e .env.development -- eas build --local -p ios --profile preview",
    "build:ios:preview": "dotenv -e .env.development -- eas build -p ios --profile preview",
    "build:ios:production:local": "dotenv -e .env.production -- eas build --local -p ios --profile production",
    "build:ios:production": "dotenv -e .env.production -- eas build -p ios --profile production",
    "build:android:development:local": "dotenv -e .env.development -- eas build --local -p android --profile development",
    "build:android:development": "dotenv -e .env.development -- eas build -p android --profile development",
    "build:android:preview:local": "dotenv -e .env.production -- eas build --local -p android --profile preview",
    "build:android:preview": "dotenv -e .env.production -- eas build -p android --profile preview",
    "build:android:production:local": "dotenv -e .env.production -- eas build --local -p android --profile production",
    "build:android:production": "dotenv -e .env.production -- eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "53.0.10",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.0",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.2.0",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.0.6",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.8",
    "expo-web-browser": "~14.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
